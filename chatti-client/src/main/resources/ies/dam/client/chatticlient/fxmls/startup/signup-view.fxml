<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefWidth="600.0" styleClass="Parent" stylesheets="@../../styles/day-ui-mode.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ies.dam.client.chatticlient.controllers.startup.SignUpController">
    <HBox alignment="CENTER_LEFT" maxHeight="-Infinity" maxWidth="1.7976931348623157E308" prefHeight="36.0" prefWidth="600.0" styleClass="TopBar">
        <Label alignment="CENTER" maxHeight="1.7976931348623157E308" minHeight="-Infinity" minWidth="-Infinity" prefWidth="143.0" styleClass="UpperLeftCorner" text="Registrate" />
        <HBox alignment="BOTTOM_LEFT" maxHeight="-Infinity" prefWidth="457.0" spacing="8.0" HBox.hgrow="ALWAYS">
            <ImageView fitHeight="32.0" fitWidth="32.0" pickOnBounds="true" preserveRatio="true">
                <HBox.margin>
                    <Insets left="5.0" top="1.0" />
                </HBox.margin>
                <Image url="@../../imgs/LogoBlanco.png" />
            </ImageView>
            <Label maxWidth="1.7976931348623157E308" styleClass="TopBarWhiteBoldText" text="Chatti" HBox.hgrow="ALWAYS">
                <padding>
                    <Insets top="3.0" />
                </padding>
            </Label>
        </HBox>
    </HBox>
    <VBox alignment="TOP_CENTER" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" minHeight="-Infinity" styleClass="lightGreyRoundCorners">
        <VBox.margin>
            <Insets bottom="10.0" left="10.0" right="10.0" />
        </VBox.margin>
        <HBox alignment="CENTER_LEFT" spacing="100.0">
            <VBox alignment="BOTTOM_LEFT" maxWidth="1.7976931348623157E308">
                <Label fx:id="accNameWarning" styleClass="WarningText" text="Este nombre esta en uso" />
                <HBox>
                    <Label maxWidth="1.7976931348623157E308" text="Nombre de cuenta" />
                    <Label text="*" textFill="RED" />
                </HBox>
                <TextField fx:id="accountNameField" maxWidth="1.7976931348623157E308" promptText="Nombre" />
            </VBox>
            <HBox alignment="BOTTOM_CENTER" maxWidth="1.7976931348623157E308" spacing="20.0">
                <Circle fx:id="profilePic" fill="DODGERBLUE" radius="32.0" stroke="BLACK" strokeType="INSIDE" styleClass="PfpBackground" />
                <Button mnemonicParsing="false" onAction="#changePfp" styleClass="ConfirmButton" text="Elegir imagen de perfil" />
            </HBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="50.0">
            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                <HBox>
                    <Label maxWidth="1.7976931348623157E308" text="Correo" />
                    <Label text="*" textFill="RED" />
                </HBox>
                <TextField fx:id="mailField" promptText="Correo electrónico" />
            </VBox>
            <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="20.0" />
        </HBox>
        <HBox alignment="CENTER_LEFT" maxWidth="1.7976931348623157E308" spacing="50.0">
            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                <HBox>
                    <Label maxWidth="1.7976931348623157E308" text="Contraseña" />
                    <Label text="*" textFill="RED" />
                </HBox>
                <PasswordField fx:id="passField" promptText="Contraseña" />
            </VBox>
            <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="20.0" />
            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                <HBox maxWidth="1.7976931348623157E308">
                    <Label maxWidth="1.7976931348623157E308" text="Nombre de usuario" />
                    <Label text="*" textFill="RED" />
                </HBox>
                <TextField fx:id="usernameField" maxWidth="1.7976931348623157E308" promptText="Nombre" />
            </VBox>
        </HBox>
        <HBox alignment="CENTER_LEFT" spacing="50.0">
            <VBox alignment="TOP_CENTER" maxWidth="1.7976931348623157E308">
                <HBox>
                    <Label maxWidth="1.7976931348623157E308" text="Confirmar contraseña" />
                    <Label text="*" textFill="RED" />
                </HBox>
                <PasswordField fx:id="confirmPassField" promptText="Confirmar" />
                <Label maxWidth="1.7976931348623157E308" text="* Campos obligatorios" textFill="RED" />
            </VBox>
            <HBox alignment="CENTER" maxWidth="1.7976931348623157E308" spacing="20.0" />
            <VBox alignment="CENTER" maxWidth="1.7976931348623157E308">
                <Label maxWidth="1.7976931348623157E308" text="Descripción" />
                <TextArea fx:id="descriptionArea" prefHeight="40.0" prefWidth="228.0" promptText="Máximo 250 carácteres" />
            </VBox>
        </HBox>
        <HBox alignment="BOTTOM_LEFT" prefWidth="530.0">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
            <HBox alignment="CENTER_RIGHT" styleClass="ButtonSection" HBox.hgrow="ALWAYS">
                <HBox.margin>
                    <Insets right="20.0" />
                </HBox.margin>
                <Button fx:id="cancel" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#cancelCreate" styleClass="CancelButton" text="Cancelar" />
                <Button fx:id="createAcc" maxHeight="1.7976931348623157E308" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#createAcc" styleClass="ConfirmButton" text="Crear cuenta" />
            </HBox>
        </HBox>
    </VBox>
</VBox>
